# Copie este arquivo para ".env" (uso local) e ajuste conforme necessário.
# Se não definir DATABASE_URL, a aplicação usa SQLite local (viagem.db).

# --- SQLite (padrão, não precisa configurar nada) ---
# DATABASE_URL=sqlite:///viagem.db

# --- PostgreSQL / Supabase (produção) ---
# No Supabase: Project Settings > Database > Connection string (modo "Session").
# DATABASE_URL=postgresql+psycopg2://usuario:senha@host:5432/nomedobanco
